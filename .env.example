# Embeddings
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
EMBEDDING_CACHE_DIR=data/models/fastembed

# Qdrant
# Use QDRANT_PATH for local-mode, or QDRANT_URL/QDRANT_API_KEY for a running Qdrant server/cloud.
QDRANT_PATH=data/index/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=code_chunks

# Tantivy
TANTIVY_INDEX_PATH=data/index/tantivy

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# LLM summarization, optional for later phases
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=

# Retrieval defaults
TOP_K=10
RERANK_TOP_K=50
RETRIEVE_TOP_K=25
FUSED_TOP_K=10
CONTEXT_TOP_K=10
GRAPH_MAX_NODES=12
RRF_K=60

# Phase 4 local synthesis through LM Studio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen3-1.7b
LMSTUDIO_TIMEOUT_SECONDS=120

# Default local index paths used by the Phase 4 agent
DENSE_BACKEND=qdrant
SPARSE_BACKEND=tantivy
GRAPH_BACKEND=sqlite
GRAPH_PATH=data/graph/rag_project.sqlite
